rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isActiveUser() {
      return isSignedIn() && (
        request.auth.token.email in ["hammadkhanniaxii@gmail.com", "hammad@growthalliance.net"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "Active")
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ["hammadkhanniaxii@gmail.com", "hammad@growthalliance.net"] ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "super_admin") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "super_admin" &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "Active")
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ["hammadkhanniaxii@gmail.com", "hammad@growthalliance.net"] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin", "hr_admin"] &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "Active")
      );
    }

    // Entity Validators
    function isValidTask(data) {
      return data.keys().hasAll(['title', 'project', 'priority', 'status', 'due', 'assignee', 'progress']) &&
        data.keys().hasOnly(['id', 'title', 'project', 'priority', 'status', 'due', 'assignee', 'progress', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.project is string && data.project.size() <= 100 &&
        data.priority in ['Urgent', 'High', 'Medium', 'Low'] &&
        data.status in ['To Do', 'In Progress', 'In Review', 'Completed'] &&
        data.due is string && data.due.size() <= 50 &&
        data.assignee is string && data.assignee.size() <= 100 &&
        data.progress is number && data.progress >= 0 && data.progress <= 100;
    }

    function isValidLeave(data) {
      return data.keys().hasAll(['employee', 'type', 'start', 'end', 'days', 'reason', 'status']) &&
        data.keys().hasOnly(['id', 'employee', 'userId', 'userEmail', 'type', 'start', 'end', 'days', 'reason', 'status', 'createdAt', 'reviewedBy', 'reviewerId', 'reviewedAt', 'rejectionReason', 'updatedAt']) &&
        data.employee is string && data.employee.size() <= 100 &&
        data.type in ['Annual', 'Sick', 'Casual'] &&
        data.start is string && data.start.size() <= 20 &&
        data.end is string && data.end.size() <= 20 &&
        data.days is number && data.days > 0 && data.days <= 365 &&
        data.reason is string && data.reason.size() <= 300 &&
        data.status in ['Pending', 'Approved', 'Declined', 'Cancelled'];
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['name', 'email', 'department', 'title', 'status']) &&
        data.keys().hasOnly(['id', 'name', 'email', 'employeeId', 'department', 'title', 'status', 'role', 'mustChangePassword', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 120 &&
        data.department is string && data.department.size() <= 80 &&
        data.title is string && data.title.size() <= 80 &&
        data.status in ['Active', 'Inactive', 'Suspended', 'On leave', 'Disabled', 'Pending Invitation', 'Invitation Expired', 'Deactivated'];
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'body', 'audience', 'published']) &&
        data.keys().hasOnly(['id', 'title', 'body', 'audience', 'published', 'authorId', 'createdAt']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.body is string && data.body.size() <= 1000 &&
        data.audience is string && data.audience.size() <= 80 &&
        data.published is string && data.published.size() <= 50;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['userId', 'state', 'clockedIn', 'worked']) &&
        data.keys().hasOnly(['userId', 'employeeName', 'employeeEmail', 'date', 'state', 'clockedIn', 'worked', 'breakMinutes', 'clockInTimestamp', 'lastWorkStartTimestamp', 'lastBreakStartTimestamp', 'accumulatedWorkedSeconds', 'breakSeconds', 'workedSeconds', 'history', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.state in ['Working', 'On break', 'Clocked out'] &&
        data.clockedIn is string && data.clockedIn.size() <= 20 &&
        data.worked is string && data.worked.size() <= 30;
    }

    function isValidNotice(data) {
      return data.keys().hasAll(['text', 'read', 'time']) &&
        data.keys().hasOnly(['id', 'userId', 'text', 'read', 'time', 'createdAt']) &&
        data.text is string && data.text.size() <= 250 &&
        data.read is bool &&
        data.time is string && data.time.size() <= 40;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['email', 'name', 'role']) &&
        data.keys().hasOnly(['id', 'email', 'name', 'employeeId', 'role', 'department', 'title', 'status', 'mustChangePassword', 'createdAt', 'updatedAt']) &&
        data.email is string && data.email.size() <= 120 &&
        data.name is string && data.name.size() <= 100 &&
        data.role in ['employee', 'manager', 'hr_admin', 'super_admin', 'admin'];
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'actorEmail', 'timestamp']) &&
        data.action is string && data.action.size() <= 150 &&
        data.actorEmail is string && data.actorEmail.size() <= 120 &&
        data.timestamp is string && data.timestamp.size() <= 50;
    }

    // Collections
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming());
      allow update: if isSignedIn() && isValidId(taskId);
      allow delete: if isAdmin();
    }

    match /leaves/{leaveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(leaveId) && isValidLeave(incoming());
      allow update: if isSignedIn() && isValidId(leaveId);
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(employeeId) && isValidEmployee(incoming());
      allow update: if (isAdmin() && isValidId(employeeId)) ||
        (isSignedIn() && incoming().email == request.auth.token.email && isValidId(employeeId));
      allow delete: if isSuperAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(announcementId) && isValidAnnouncement(incoming());
      allow update: if isAdmin() && isValidId(announcementId);
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(attendanceId);
      allow delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(noticeId);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if (isAdmin() || (isSignedIn() && isOwner(userId) && incoming().email == request.auth.token.email)) && isValidId(userId) && isValidUserAccount(incoming());
      allow update: if (isAdmin() && isValidId(userId)) || (isOwner(userId) && isSignedIn() && isValidId(userId));
      allow delete: if isSuperAdmin();
    }

    match /invitations/{invitationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isAdmin() && isValidId(invitationId);
      allow update: if (isAdmin() && isValidId(invitationId)) ||
        (isSignedIn() && existing().email == request.auth.token.email &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedAt']));
      allow delete: if isSuperAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && (isOwner(adminId) || isAdmin());
      allow write: if isSuperAdmin() && isValidId(adminId);
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false; // immutable audit log
    }

    match /access_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isValidId(requestId);
      allow update, delete: if isAdmin() && isValidId(requestId);
    }

    match /system_metadata/{docId} {
      allow read: if true;
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
