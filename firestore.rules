rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ["hammad@growthalliance.net", "hammadkhanniaxii@gmail.com"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "super_admin")
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ["hammad@growthalliance.net", "hammadkhanniaxii@gmail.com"] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin", "hr_admin"])
      );
    }

    // Entity Validators
    function isValidTask(data) {
      return data.keys().hasAll(['title', 'project', 'priority', 'status', 'due', 'assignee', 'progress']) &&
        data.keys().hasOnly(['id', 'title', 'project', 'priority', 'status', 'due', 'assignee', 'progress', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.project is string && data.project.size() <= 100 &&
        data.priority in ['Urgent', 'High', 'Medium', 'Low'] &&
        data.status in ['To Do', 'In Progress', 'In Review', 'Completed'] &&
        data.due is string && data.due.size() <= 50 &&
        data.assignee is string && data.assignee.size() <= 100 &&
        data.progress is number && data.progress >= 0 && data.progress <= 100;
    }

    function isValidLeave(data) {
      return data.keys().hasAll(['employee', 'type', 'start', 'end', 'days', 'reason', 'status']) &&
        data.keys().hasOnly(['id', 'employee', 'userId', 'type', 'start', 'end', 'days', 'reason', 'status', 'createdAt']) &&
        data.employee is string && data.employee.size() <= 100 &&
        data.type in ['Annual', 'Sick', 'Casual'] &&
        data.start is string && data.start.size() <= 20 &&
        data.end is string && data.end.size() <= 20 &&
        data.days is number && data.days > 0 && data.days <= 365 &&
        data.reason is string && data.reason.size() <= 300 &&
        data.status in ['Pending', 'Approved', 'Declined', 'Cancelled'];
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['name', 'email', 'department', 'title', 'status']) &&
        data.keys().hasOnly(['id', 'name', 'email', 'employeeId', 'department', 'title', 'status', 'role', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 120 &&
        data.department is string && data.department.size() <= 80 &&
        data.title is string && data.title.size() <= 80 &&
        data.status in ['Active', 'Inactive', 'Suspended', 'On leave'];
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'body', 'audience', 'published']) &&
        data.keys().hasOnly(['id', 'title', 'body', 'audience', 'published', 'authorId', 'createdAt']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.body is string && data.body.size() <= 1000 &&
        data.audience is string && data.audience.size() <= 80 &&
        data.published is string && data.published.size() <= 50;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['userId', 'state', 'clockedIn', 'worked']) &&
        data.keys().hasOnly(['userId', 'employeeName', 'date', 'state', 'clockedIn', 'worked', 'breakMinutes']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.state in ['Working', 'On break', 'Clocked out'] &&
        data.clockedIn is string && data.clockedIn.size() <= 20 &&
        data.worked is string && data.worked.size() <= 20;
    }

    function isValidNotice(data) {
      return data.keys().hasAll(['text', 'read', 'time']) &&
        data.keys().hasOnly(['id', 'userId', 'text', 'read', 'time', 'createdAt']) &&
        data.text is string && data.text.size() <= 250 &&
        data.read is bool &&
        data.time is string && data.time.size() <= 40;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['email', 'name', 'role']) &&
        data.keys().hasOnly(['email', 'name', 'employeeId', 'role', 'department', 'title', 'status', 'createdAt', 'updatedAt']) &&
        data.email is string && data.email.size() <= 120 &&
        data.name is string && data.name.size() <= 100 &&
        data.role in ['employee', 'manager', 'hr_admin', 'super_admin', 'admin'];
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'actorEmail', 'timestamp']) &&
        data.action is string && data.action.size() <= 150 &&
        data.actorEmail is string && data.actorEmail.size() <= 120 &&
        data.timestamp is string && data.timestamp.size() <= 50;
    }

    // Collections
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if isValidId(taskId) && isValidTask(incoming());
      allow update: if isValidId(taskId) && isValidTask(incoming());
      allow delete: if isAdmin();
    }

    match /leaves/{leaveId} {
      allow read: if true;
      allow create: if isValidId(leaveId) && isValidLeave(incoming());
      allow update: if isValidId(leaveId) && isValidLeave(incoming());
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if true;
      allow create, update: if isValidId(employeeId) && isValidEmployee(incoming());
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isValidId(announcementId) && isValidAnnouncement(incoming());
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update: if isValidId(attendanceId) && isValidAttendance(incoming());
      allow delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create, update: if isValidId(noticeId) && isValidNotice(incoming());
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUserAccount(incoming());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && isValidUserAccount(incoming()) && !incoming().diff(existing()).affectedKeys().hasAny(['role']))
      );
      allow delete: if isSuperAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidAuditLog(incoming());
      allow update, delete: if false; // immutable audit log
    }
  }
}
